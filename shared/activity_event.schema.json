{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://activity-ai.local/schemas/activity_event.schema.json",
  "title": "Activity AI Event",
  "type": "object",
  "required": ["event_id", "device_id", "platform", "event_type", "started_at_ms", "source", "privacy_level"],
  "properties": {
    "event_id": {"type": "string", "minLength": 8},
    "device_id": {"type": "string", "minLength": 4},
    "platform": {"enum": ["android", "windows"]},
    "event_type": {"enum": ["app_foreground", "app_background", "session", "idle_start", "idle_end", "device_lock", "device_unlock"]},
    "app_id": {"type": ["string", "null"]},
    "app_name": {"type": ["string", "null"]},
    "window_title": {"type": ["string", "null"]},
    "activity_label": {"type": ["string", "null"]},
    "project_label": {"type": ["string", "null"]},
    "started_at_ms": {"type": "integer", "minimum": 0},
    "ended_at_ms": {"type": ["integer", "null"], "minimum": 0},
    "duration_ms": {"type": ["integer", "null"], "minimum": 0},
    "source": {"enum": ["usage_stats", "windows_foreground", "windows_idle", "manual", "derived"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "privacy_level": {"enum": ["telemetry", "metadata", "visual_allowed", "blocked"]},
    "metadata": {"type": "object", "additionalProperties": true}
  },
  "additionalProperties": false
}
